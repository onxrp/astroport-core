# Astroport deploy configuration.
# Copy to scripts/deploy/.env and fill in. That file is gitignored; never commit
# a filled-in copy -- it names the key that signs every transaction.
#
#   cp scripts/deploy/.env.example scripts/deploy/.env

# ==========================================
# Network (defaults shown are Coreum testnet-1)
# ==========================================
ASTRO_NODE=https://rpc.testnet-1.tx.org:443
ASTRO_CHAIN_ID=coreum-testnet-1
ASTRO_GAS_PRICES=0.0625utestcore

# ==========================================
# Signer
# ------------------------------------------
# The key name as it appears in `cored keys list`. This account pays for and
# signs everything, and becomes contract admin unless ASTRO_ADMIN says otherwise.
# ==========================================
ASTRO_DEPLOYER_KEY_NAME=

# Optional. Lets --dry-run resolve an address without keyring access.
# Leave empty to derive it from the key name.
ASTRO_DEPLOYER_ADDR=

# Keyring backend: file (default), os, or test.
ASTRO_KEYRING_BACKEND=file

# Optional. Set to skip the interactive passphrase prompt, e.g. in CI.
# Prefer leaving this empty and typing the passphrase.
# KEYRING_PASSPHRASE=

# ==========================================
# Ownership
# ------------------------------------------
# Both default to the deployer address. Set ASTRO_OWNER to a multisig for
# anything that outlives a testnet experiment.
# ==========================================
ASTRO_OWNER=
ASTRO_ADMIN=

# ==========================================
# Tokens
# ==========================================
# The reward/stake denom for vesting, incentives, staking and maker. On Coreum
# this is a fully qualified Asset-FT denom: <subunit>-<issuer address>.
# Required for those four contracts; ignored by the rest.
ASTRO_TOKEN_DENOM=

# Coreum's token factory module address, used by staking and the factory's
# tracker config. Defaults to ASTRO_OWNER if unset.
ASTRO_TOKEN_FACTORY_ADDR=

# Decimals to register in the coin registry, as "denom:decimals" pairs.
#
# This is not optional bookkeeping. Pair contracts query the registry during
# swaps (query_token_precision); a pool whose denom is missing here fails on
# chain with "The <denom> precision was not found". Register every denom you
# intend to trade BEFORE creating pairs for it.
#
#   ASTRO_REGISTER_COINS=utestcore:6,utx-testcore1abc...:6
ASTRO_REGISTER_COINS=

# ==========================================
# Referencing an existing deployment
# ------------------------------------------
# Set these to deploy a single contract against infrastructure that is already
# live, without a --resume log. Example: deploying only the router.
# ==========================================
ASTRO_FACTORY_ADDR=
ASTRO_REGISTRY_ADDR=
ASTRO_VESTING_ADDR=
ASTRO_STAKING_ADDR=

# ==========================================
# Oracle
# ------------------------------------------
# The oracle tracks exactly one pair, so both denoms must be named.
# Only needed when 'oracle' is in --only.
# ==========================================
ASTRO_ORACLE_ASSET_1=
ASTRO_ORACLE_ASSET_2=

# ==========================================
# Migration targets
# ------------------------------------------
# Defaults point at the live Coreum testnet deployment affected by the MsgBurn
# tag bug. Comma-separated; override when migrating a different deployment.
# ==========================================
# ASTRO_MIGRATE_PAIRS=testcore1awuq...,testcore13lk8...
# ASTRO_MIGRATE_FACTORIES=testcore1j50s...,testcore135e9...

# Fee parameters restated on UpdatePairConfig. That message overwrites the whole
# PairConfig struct rather than merging, so these must match the live values or
# the pool starts trading at zero fees.
ASTRO_XYK_TOTAL_FEE_BPS=30
ASTRO_XYK_MAKER_FEE_BPS=3333

# Coreum charges an Asset-FT issue fee, attached as funds to CreatePair so the
# pair can mint its LP denom. 10 CORE on testnet.
ASTRO_LP_DENOM_CREATION_FEE=10000000utestcore

# ==========================================
# Transaction tuning
# ==========================================
DEFAULT_GAS=auto
DEFAULT_GAS_ADJUSTMENT=1.4
TX_WAIT_ATTEMPTS=10
